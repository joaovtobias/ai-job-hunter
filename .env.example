# ==========================================================
# EXEMPLO DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo para .env e preencha suas chaves reais
# ==========================================================

# 0. Chave da API do Google Gemini
GEMINI_API_KEY=SUA_GEMINI_API_KEY_AQUI

# 1. Seu número de WhatsApp com DDI (55) + DDD + Número (apenas dígitos)
WHATSAPP_PHONE=5511999999999

# 2. Green-API (https://console.green-api.com)
GREEN_API_INSTANCE_ID=SEU_INSTANCE_ID
GREEN_API_TOKEN=SEU_API_TOKEN_INSTANCE

# 3. Twilio WhatsApp Sandbox (Opcional)
TWILIO_ACCOUNT_SID=SEU_ACCOUNT_SID
TWILIO_AUTH_TOKEN=SEU_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=14155238886

# 4. Configurações do Robô de Monitoramento
SCORE_MINIMO_WHATSAPP=60
INTERVALO_HORAS=4

